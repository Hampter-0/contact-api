# server
NODE_ENV=development
PORT=3001
# how many proxies sit in front of the app (1 = nginx / cloudflare tunnel etc)
TRUST_PROXY=1
# comma separated if you have more than one
CORS_ORIGINS=http://localhost:5173

# feature toggles (true / false)
FEATURE_RATE_LIMIT=true
FEATURE_TURNSTILE=true
FEATURE_LINK_FILTER=true
FEATURE_DISCORD_WEBHOOK=true
FEATURE_EMAIL_CONFIRMATION=false
FEATURE_EMAIL_SIGNATURE=true
FEATURE_EMAIL_NOTIFICATION=false

# limits
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=2

# needed if FEATURE_TURNSTILE=true
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here

# needed if FEATURE_DISCORD_WEBHOOK=true
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# needed if FEATURE_EMAIL_CONFIRMATION=true or FEATURE_EMAIL_NOTIFICATION=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=yourname@gmail.com
SMTP_PASS=your_smtp_password_or_app_key
SMTP_FROM=noreply@yourdomain.com

# confirmation mail (sent to the visitor)
BRAND_NAME=My Portfolio
EMAIL_SUBJECT=I received your message
EMAIL_BODY=I have received your message! I'll try to reply within 48 hours :)

# notification mail (sent to you, needed if FEATURE_EMAIL_NOTIFICATION=true)
NOTIFICATION_EMAIL=yourname@gmail.com
NOTIFICATION_EMAIL_SUBJECT=New contact form submission

# signature (all optional, leave empty to skip that part)
SIGNATURE_NAME=hampter
SIGNATURE_TITLE=Support Team
SIGNATURE_TAGLINE=Kind regards,
SIGNATURE_LOGO_URL=https://yourdomain.com/assets/logo.png
SIGNATURE_LOGO_WIDTH=140
SIGNATURE_ADDRESS_LINE1=123 Example Street
SIGNATURE_ADDRESS_LINE2=1234 AB Example City
SIGNATURE_PHONE=+31 6 12345678
SIGNATURE_CONTACT_EMAIL=support@yourdomain.com
SIGNATURE_WEBSITE_URL=https://yourdomain.com
SIGNATURE_DISCORD_LINK=https://discord.gg/your_invite_code
SIGNATURE_FOOTER_NOTE=This is an automated message, please don't reply directly to this email.
SIGNATURE_ACCENT_COLOR=#7c3aed